# MKEA LLM configuration.
#
# Default provider: OpenCode Go (OpenAI-compatible chat completions).
# Default model: DeepSeek V4.1 Flash.
# Copy this file to `.env`, then fill MKEA_LLM_API_KEY.
# `.env` is gitignored; never commit real keys.

MKEA_LLM_API_KEY=
MKEA_LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
MKEA_LLM_MODEL=deepseek-v4.1-flash

# Optional request settings
MKEA_LLM_TIMEOUT=600
MKEA_LLM_MAX_TOKENS=65536
MKEA_LLM_TEMPERATURE=0

# Optional: stable session id for OpenCode Go prompt caching.
# Leave empty to generate one per run.
MKEA_LLM_SESSION_ID=

# To use a different OpenAI-compatible provider, override:
# MKEA_LLM_BASE_URL=https://api.openai.com/v1
# MKEA_LLM_MODEL=gpt-4.1-mini
# MKEA_LLM_API_KEY=sk-...
